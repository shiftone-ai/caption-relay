  "components": {
    "schemas": {
      "AiModelOption": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "gemini-3.1-flash-lite",
              "claude-haiku-4-5",
              "gpt-5.3-codex",
              "gpt-5.4-mini-2026-03-17"
            ],
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gemini",
              "claude",
              "codex",
              "openai"
            ],
            "title": "Provider"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "input_usd_per_million": {
            "type": "number",
            "title": "Input Usd Per Million"
          },
          "output_usd_per_million": {
            "type": "number",
            "title": "Output Usd Per Million"
          },
          "pricing_url": {
            "type": "string",
            "title": "Pricing Url"
          },
          "pricing_checked_on": {
            "type": "string",
            "title": "Pricing Checked On",
            "default": "2026-10-05"
          },
          "measured_latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measured Latency Ms"
          },
          "latency_samples": {
            "type": "integer",
            "title": "Latency Samples",
            "default": 0
          },
          "configured": {
            "type": "boolean",
            "title": "Configured",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "provider",
          "label",
          "input_usd_per_million",
          "output_usd_per_million",
          "pricing_url"
        ],
        "title": "AiModelOption"
      },
      "AiRequest": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "model_id": {
            "type": "string",
            "enum": [
              "gemini-3.1-flash-lite",
              "claude-haiku-4-5",
              "gpt-5.3-codex",
              "gpt-5.4-mini-2026-03-17"
            ],
            "title": "Model Id"
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Source Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "model_id",
          "source_revision"
        ],
        "title": "AiRequest"
      },
      "AiResultInfo": {
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "title": "Request Id"
          },
          "model_id": {
            "type": "string",
            "enum": [
              "gemini-3.1-flash-lite",
              "claude-haiku-4-5",
              "gpt-5.3-codex",
              "gpt-5.4-mini-2026-03-17"
            ],
            "title": "Model Id"
          },
          "elapsed_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Elapsed Ms"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "model_id",
          "elapsed_ms"
        ],
        "title": "AiResultInfo"
      },
      "AiRouting": {
        "properties": {
          "settings": {
            "$ref": "#/components/schemas/AiSettings"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/AiModelOption"
            },
            "type": "array",
            "title": "Models"
          },
          "selected_model": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "gemini-3.1-flash-lite",
                  "claude-haiku-4-5",
                  "gpt-5.3-codex",
                  "gpt-5.4-mini-2026-03-17"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Model"
          },
          "reason": {
            "type": "string",
            "enum": [
              "off",
              "manual",
              "cost",
              "speed",
              "unmeasured"
            ],
            "title": "Reason"
          },
          "connected": {
            "type": "boolean",
            "title": "Connected",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "settings",
          "models",
          "selected_model",
          "reason"
        ],
        "title": "AiRouting"
      },
      "AiSettings": {
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "off",
              "manual",
              "cost",
              "speed"
            ],
            "title": "Strategy",
            "default": "off"
          },
          "preferred_model": {
            "type": "string",
            "enum": [
              "gemini-3.1-flash-lite",
              "claude-haiku-4-5",
              "gpt-5.3-codex",
              "gpt-5.4-mini-2026-03-17"
            ],
            "title": "Preferred Model",
            "default": "gemini-3.1-flash-lite"
          },
          "candidates": {
            "items": {
              "type": "string",
              "enum": [
                "gemini-3.1-flash-lite",
                "claude-haiku-4-5",
                "gpt-5.3-codex",
                "gpt-5.4-mini-2026-03-17"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Candidates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AiSettings"
      },
      "Caption": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "utterance_id": {
            "type": "string",
            "title": "Utterance Id"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          },
          "source_revision": {
            "type": "integer",
            "title": "Source Revision"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "original": {
            "type": "string",
            "title": "Original"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "speaker": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaker"
          },
          "human_edited": {
            "type": "boolean",
            "title": "Human Edited",
            "default": false
          },
          "published": {
            "type": "boolean",
            "title": "Published"
          },
          "publish_eligible": {
            "type": "boolean",
            "title": "Publish Eligible"
          },
          "formatted_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Formatted Text"
          },
          "source_final": {
            "type": "boolean",
            "title": "Source Final",
            "default": true
          },
          "public_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Text"
          },
          "public_speaker": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Speaker"
          },
          "public_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Revision"
          },
          "ai_request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AiRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "ai_result": {
