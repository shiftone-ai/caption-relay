            "title": "Font",
            "default": "sans"
          },
          "font_size": {
            "type": "integer",
            "maximum": 96.0,
            "minimum": 24.0,
            "title": "Font Size",
            "default": 64
          },
          "font_weight": {
            "type": "string",
            "enum": [
              "normal",
              "bold"
            ],
            "title": "Font Weight",
            "default": "bold"
          },
          "line_height": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 1.2,
            "title": "Line Height",
            "default": 1.5
          },
          "padding": {
            "type": "integer",
            "maximum": 160.0,
            "minimum": 0.0,
            "title": "Padding",
            "default": 48
          },
          "position": {
            "type": "string",
            "enum": [
              "top",
              "center",
              "bottom"
            ],
            "title": "Position",
            "default": "center"
          },
          "align": {
            "type": "string",
            "enum": [
              "left",
              "center"
            ],
            "title": "Align",
            "default": "left"
