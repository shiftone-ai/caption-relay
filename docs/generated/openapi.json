            "title": "Command"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "command"
        ],
        "title": "Command"
      },
      "ConflictDetail": {
        "properties": {
          "message": {
            "type": "string",
            "const": "revision conflict",
