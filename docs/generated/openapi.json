      "CaptionPatch": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "base_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Base Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "base_revision"
        ],
        "title": "CaptionPatch"
      },
      "Command": {
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "show",
              "hide"
