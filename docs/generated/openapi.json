            "$ref": "#/components/schemas/Caption"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latest"
        ],
        "title": "ConflictDetail"
      },
      "ConflictResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ConflictDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ConflictResponse"
      },
      "DisplaySettings": {
        "properties": {
          "background": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Background",
            "default": "#0a0a0a"
          },
          "foreground": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Foreground",
            "default": "#ffffff"
          },
          "font": {
            "type": "string",
            "enum": [
              "sans",
              "serif",
              "mono"
