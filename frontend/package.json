{
  "name": "caption-relay-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:api": "uv run --project ../backend python ../scripts/export_openapi.py && openapi-typescript ../docs/generated/openapi.json -o src/generated/api.d.ts",
    "check:api": "uv run --project ../backend python ../scripts/export_openapi.py --check && node scripts/check-api.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.50.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xstate": "5.33.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "patch-package": "8.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
