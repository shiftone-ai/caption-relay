{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caption Relay",
  "version": "0.2.0",
  "identifier": "ai.shiftone.caption-relay",
  "build": { "frontendDist": "../frontend/dist" },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [{ "identifier": "desktop", "windows": ["settings"], "remote": { "urls": ["http://127.0.0.1:*"] }, "permissions": ["credentials"] }]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "targets": ["app", "dmg"],
    "resources": { "../.cache/desktop/caption-relay-service/": "backend/" },
    "macOS": { "minimumSystemVersion": "13.0", "infoPlist": "Info.plist", "entitlements": "Entitlements.plist", "signingIdentity": "-" }
  }
}
